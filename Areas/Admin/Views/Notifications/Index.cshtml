@model List<EcommerceApp.Models.Notification>

@{
    ViewData["Title"] = "الإشعارات";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-bell"></i> الإشعارات</h2>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm p-5">
            <i class="bi bi-bell-slash fs-1 d-block mb-3 text-secondary"></i>
            <h4 class="alert-heading">لا توجد إشعارات</h4>
            <p class="mb-0">لم تتلق أي إشعارات بعد.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var notification in Model)
            {
                <div class="col-12 mb-3">
                    <div class="card @(!notification.IsRead ? "border-primary" : "")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h5 class="card-title mb-2">
                                        @if (!notification.IsRead)
                                        {
                                            <span class="badge bg-primary me-2">جديد</span>
                                        }
                                        @notification.Title
                                    </h5>
                                    <p class="card-text mb-2">@notification.Message</p>
                                    <small class="text-muted">
                                        <i class="bi bi-clock"></i>
                                        @{
                                            var timeAgo = DateTime.Now - notification.CreatedAt;
                                            var timeText = timeAgo.TotalMinutes < 1 ? "الآن" :
                                                          timeAgo.TotalHours < 1 ? $"منذ {(int)timeAgo.TotalMinutes} دقيقة" :
                                                          timeAgo.TotalDays < 1 ? $"منذ {(int)timeAgo.TotalHours} ساعة" :
                                                          $"منذ {(int)timeAgo.TotalDays} يوم";
                                        }
                                        @timeText
                                    </small>
                                </div>
                                <div class="ms-3">
                                    @if (notification.OrderId.HasValue)
                                    {
                                        <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@notification.OrderId" class="btn btn-sm btn-outline-primary mb-2">
                                            <i class="bi bi-eye"></i> عرض الطلب
                                        </a>
                                    }
                                    @if (!notification.IsRead)
                                    {
                                        <form asp-action="MarkAsRead" asp-route-id="@notification.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-check2"></i> تم القراءة
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
