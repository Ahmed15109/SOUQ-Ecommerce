
@model EcommerceApp.ViewModels.PagedResult<EcommerceApp.Models.ApplicationUser>

@{
    ViewData["Title"] = "إدارة المسؤولين";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">المسؤولون (@Model.TotalCount)</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus-fill me-2"></i>إضافة مسؤول
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="py-3 ps-4">البريد الإلكتروني</th>
                        <th class="py-3">الدور</th>
                        <th class="py-3">الحالة</th>
                        <th class="py-3">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Items)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@user.Email</td>
                             <td><span class="badge bg-success rounded-pill">مسؤول</span></td>
                            <td>
                                @if (user.LockoutEnd > DateTimeOffset.UtcNow)
                                {
                                    <span class="badge bg-danger">معطل</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">نشط</span>
                                }
                            </td>
                            <td>
                                <form asp-action="ToggleLockout" asp-route-id="@user.Id" method="post"
                                      data-confirm="هل تريد تغيير حالة هذا الحساب؟">
                                    <button type="submit" class="btn btn-sm btn-outline-warning">
                                        @(user.LockoutEnd > DateTimeOffset.UtcNow ? "تفعيل" : "تعطيل")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_Pagination" model="Model" />
</div>
