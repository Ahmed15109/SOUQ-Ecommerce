@model EcommerceApp.Models.ProductWeightTier

@{
    var product = ViewData["Product"] as EcommerceApp.Models.Product;
    ViewData["Title"] = "إضافة شريحة وزن - " + (product?.Name ?? "منتج");
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">إضافة شريحة جديدة: @(product?.Name ?? "منتج")</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="ProductId" />

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label asp-for="FromKg" class="form-label">من وزن</label>
                                <input asp-for="FromKg" class="form-control" type="number" step="0.1" />
                                <span asp-validation-for="FromKg" class="text-danger"></span>
                            </div>
                            <div class="col-6 mb-3">
                                <label asp-for="ToKg" class="form-label">إلى وزن</label>
                                <input asp-for="ToKg" class="form-control" type="number" step="0.1" />
                                <span asp-validation-for="ToKg" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PricePerKg" class="form-label">السعر لكل كيلو</label>
                            <input asp-for="PricePerKg" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="PricePerKg" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" asp-route-productId="@Model.ProductId" class="btn btn-outline-secondary">إلغاء</a>
                            <button type="submit" class="btn btn-primary px-4">إضافة</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
