@using EcommerceApp.Helpers
@model EcommerceApp.ViewModels.PagedResult<EcommerceApp.Models.Order>

@{
    ViewData["Title"] = "إدارة الطلبات";
    var currentStatus = ViewBag.CurrentStatus as EcommerceApp.Models.OrderStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3">إدارة الطلبات (@Model.TotalCount)</h1>
    <div class="btn-group">
        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            تصفية حسب الحالة: @(currentStatus.HasValue ? currentStatus.Value.GetDisplayName() : "الكل")
        </button>
        <ul class="dropdown-menu">
            <li><a class="dropdown-item" asp-action="Index">الكل</a></li>
            <li><hr class="dropdown-divider"></li>
            @foreach (EcommerceApp.Models.OrderStatus status in Enum.GetValues(typeof(EcommerceApp.Models.OrderStatus)))
            {
                <li><a class="dropdown-item" asp-action="Index" asp-route-status="@status">@status.GetDisplayName()</a></li>
            }
        </ul>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>رقم الطلب</th>
                        <th>العميل</th>
                        <th>التاريخ</th>
                        <th>الحالة</th>
                        <th>المبلغ</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>#@item.Id</td>
                            <td>
                                <div class="fw-bold">@item.FullName</div>
                                <div class="small text-muted">@item.Phone</div>
                            </td>
                            <td>@item.CreatedAt.ToCairoTime().ToString("yyyy/MM/dd HH:mm")</td>
                            <td>
                                @{
                                    var badgeClass = item.Status switch
                                    {
                                        EcommerceApp.Models.OrderStatus.Pending => "bg-warning text-dark",
                                        EcommerceApp.Models.OrderStatus.Processing => "bg-info text-dark",
                                        EcommerceApp.Models.OrderStatus.Shipped => "bg-primary",
                                        EcommerceApp.Models.OrderStatus.Delivered => "bg-success",
                                        EcommerceApp.Models.OrderStatus.Canceled => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@item.Status.GetDisplayName()</span>
                            </td>
                            <td class="fw-bold">@item.Total.ToString("N2") ج.م</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> عرض
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_Pagination" model="Model" />
