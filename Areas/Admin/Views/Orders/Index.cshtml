@model IEnumerable<EcommerceApp.Models.Order>

@{
    ViewData["Title"] = "إدارة الطلبات";
    var currentStatus = ViewBag.CurrentStatus as EcommerceApp.Models.OrderStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3">إدارة الطلبات</h1>
    <div class="btn-group">
        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            تصفية حسب الحالة: @(currentStatus.HasValue ? currentStatus.Value.ToString() : "الكل")
        </button>
        <ul class="dropdown-menu">
            <li><a class="dropdown-item" asp-action="Index">الكل</a></li>
            <li><hr class="dropdown-divider"></li>
            @foreach (var status in Enum.GetValues(typeof(EcommerceApp.Models.OrderStatus)))
            {
                <li><a class="dropdown-item" asp-action="Index" asp-route-status="@status">@status</a></li>
            }
        </ul>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>رقم الطلب</th>
                        <th>العميل</th>
                        <th>التاريخ</th>
                        <th>الحالة</th>
                        <th>المبلغ</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.Id</td>
                            <td>
                                <div class="fw-bold">@item.FullName</div>
                                <div class="small text-muted">@item.Phone</div>
                            </td>
                            <td>@item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td>
                                @switch (item.Status)
                                {
                                    case EcommerceApp.Models.OrderStatus.Pending:
                                        <span class="badge bg-warning text-dark">قيد الانتظار</span>
                                        break;
                                    case EcommerceApp.Models.OrderStatus.Processing:
                                        <span class="badge bg-info text-dark">قيد التجهيز</span>
                                        break;
                                    case EcommerceApp.Models.OrderStatus.Shipped:
                                        <span class="badge bg-primary">تم الشحن</span>
                                        break;
                                    case EcommerceApp.Models.OrderStatus.Delivered:
                                        <span class="badge bg-success">تم التوصيل</span>
                                        break;
                                    case EcommerceApp.Models.OrderStatus.Canceled:
                                        <span class="badge bg-danger">ملغي</span>
                                        break;
                                }
                            </td>
                            <td class="fw-bold">$@item.Total</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> عرض
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
