@using EcommerceApp.Helpers
@model EcommerceApp.Models.Order

@{
    ViewData["Title"] = "تفاصيل الطلب #" + Model.Id;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3">تفاصيل الطلب <span>#@Model.Id</span></h1>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right"></i> العودة للقائمة
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <!-- Products -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">المنتجات</h5>
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th style="width: 80px;"></th>
                            <th>المنتج</th>
                            <th class="text-center">الكمية</th>
                            <th class="text-end">السعر</th>
                            <th class="text-end">الإجمالي</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td class="text-center py-3">
                                    <img src="@item.ImageUrl" class="rounded border" style="width: 50px; height: 50px; object-fit: cover;">
                                </td>
                                <td class="py-3">
                                    <h6 class="mb-0">@item.ProductName</h6>
                                </td>
                                <td class="text-center py-3">x @item.Quantity</td>
                                <td class="text-end py-3">@item.UnitPrice.ToString("N2") ج.م</td>
                                <td class="text-end py-3 fw-bold">@item.LineTotal.ToString("N2") ج.م</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- Status Management -->
        <div class="card shadow-sm mb-4 border-primary">
             <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0"><i class="bi bi-gear-fill me-2"></i> إدارة الحالة</h5>
            </div>
            <div class="card-body">
                <form asp-action="UpdateStatus" method="post" class="row align-items-end g-3">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)" />
                    <div class="col-md-8">
                        <label class="form-label fw-bold">تحديث حالة الطلب</label>
                        <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<EcommerceApp.Models.OrderStatus>()">
                             <option selected disabled>اختر الحالة...</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-check-circle me-1"></i> حفظ التغييرات
                        </button>
                    </div>
                </form>
                <div class="mt-3">
                    <span class="text-muted">الحالة الحالية: </span>
                    <span class="fw-bold badge bg-secondary fs-6">@Model.Status.GetDisplayName()</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Customer Info -->
        <div class="card shadow-sm mb-4">
             <div class="card-header bg-white py-3">
                <h5 class="mb-0">بيانات العميل</h5>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-light rounded-circle p-3 me-3">
                        <i class="bi bi-person fs-4 text-primary"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold">@Model.FullName</h6>
                        <small class="text-muted">@(Model.User?.Email ?? "Guest")</small>
                    </div>
                </div>
                <div class="mb-2">
                    <i class="bi bi-telephone text-muted me-2"></i> @Model.Phone
                </div>
            </div>
        </div>

        <!-- Shipping Address -->
        <div class="card shadow-sm mb-4">
             <div class="card-header bg-white py-3">
                <h5 class="mb-0">عنوان التوصيل</h5>
            </div>
            <div class="card-body">
                <div class="mb-0">
                    <strong>@Model.City, @Model.Area</strong><br>
                    @Model.Street, @Model.Building
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="mt-2 p-2 bg-warning bg-opacity-10 rounded border border-warning">
                            <i class="bi bi-info-circle me-1"></i> <strong>ملاحظات:</strong> @Model.Notes
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="card shadow-sm">
             <div class="card-header bg-white py-3">
                <h5 class="mb-0">الفاتورة</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">المجموع</span>
                    <span>@Model.Subtotal.ToString("N2") ج.م</span>
                </div>
                 <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">التوصيل</span>
                    <span>@Model.DeliveryFee.ToString("N2") ج.م</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between">
                    <span class="fw-bold fs-5">الإجمالي</span>
                    <span class="fw-bold fs-5 text-primary">@Model.Total.ToString("N2") ج.م</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script nonce="@Context.Items["CspNonce"]">
        document.querySelector('select[name="status"]').value = "@((int)Model.Status)";
    </script>
}
