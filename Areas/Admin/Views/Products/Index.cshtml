@model IEnumerable<EcommerceApp.Models.Product>

@{
    ViewData["Title"] = "إدارة المنتجات";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>المنتجات</h2>
        
        <div class="d-flex gap-2">
            <form asp-action="Index" method="get" class="d-flex align-items-center">
                <select name="categoryId" class="form-select me-2" asp-items="ViewBag.Categories" onchange="this.form.submit()">
                    <option value="">كل الأقسام</option>
                </select>
            </form>
            <a asp-action="Create" class="btn btn-primary text-nowrap"><i class="bi bi-plus-lg me-1"></i>منتج جديد</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>الاسم</th>
                            <th>القسم</th>
                            <th>السعر</th>
                            <th>صورة</th>
                            <th class="text-end">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle">@item.Name</td>
                                <td class="align-middle">@item.Category?.Name</td>
                                <td class="align-middle">@item.Price.ToString("C")</td>
                                <td class="align-middle">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" class="rounded" width="40" height="40" style="object-fit: cover;" />
                                    }
                                </td>
                                <td class="align-middle text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="تعديل"><i class="bi bi-pencil"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="حذف"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
