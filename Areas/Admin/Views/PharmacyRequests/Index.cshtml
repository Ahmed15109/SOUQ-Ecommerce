@using EcommerceApp.Helpers
@model EcommerceApp.ViewModels.PagedResult<EcommerceApp.Models.PharmacyRequest>

@{
    ViewData["Title"] = "طلبات الصيدلية";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">طلبات الصيدلية (@Model.TotalCount)</h1>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">قائمة الطلبات الأخيرة</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>رقم الطلب</th>
                            <th>التاريخ</th>
                            <th>العميل</th>
                            <th>الهاتف</th>
                            <th>العنوان</th>
                            <th>تفاصيل</th>
                            <th>صورة الروشتة</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>#@item.Id</td>
                                <td>@item.CreatedAt.ToCairoTime().ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@item.FullName</td>
                                <td>@item.UserPhone</td>
                                <td>@item.Address</td>
                                <td>
                                    @item.Items.Count دواء
                                    @if(item.Items.Count > 0)
                                    {
                                        <ul class="small mb-0 ps-3">
                                            @foreach(var med in item.Items.Take(2))
                                            {
                                                <li>@med.MedicineName (@med.Quantity)</li>
                                            }
                                            @if(item.Items.Count > 2)
                                            {
                                                <li>... المزيد</li>
                                            }
                                        </ul>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i> التفاصيل
                                    </a>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.PrescriptionImagePath))
                                    {
                                        <a asp-area="" asp-controller="PharmacyRequests" asp-action="DownloadPrescription"
                                           asp-route-id="@item.Id" target="_blank" rel="noopener" class="btn btn-sm btn-info">
                                            <i class="bi bi-image"></i> عرض
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var badgeClass = item.Status switch
                                        {
                                            EcommerceApp.Models.PharmacyRequestStatus.New => "primary",
                                            EcommerceApp.Models.PharmacyRequestStatus.Processing => "info",
                                            EcommerceApp.Models.PharmacyRequestStatus.Shipped => "warning",
                                            EcommerceApp.Models.PharmacyRequestStatus.Delivered => "success",
                                            EcommerceApp.Models.PharmacyRequestStatus.Cancelled => "danger",
                                            _ => "secondary"
                                        };
                                    }
                                    <span class="badge bg-@badgeClass">
                                        @item.Status.GetDisplayName()
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <partial name="_Pagination" model="Model" />
</div>
