@using EcommerceApp.Helpers
@model EcommerceApp.Models.PharmacyRequest

@{
    ViewData["Title"] = "تفاصيل طلب الصيدلية";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">تفاصيل الطلب #@Model.Id</h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-right"></i> عودة للقائمة
        </a>
    </div>

    <div class="row">
        <!-- Client Info -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">بيانات العميل</h6>
                </div>
                <div class="card-body">
                    <p><strong>الاسم:</strong> @Model.FullName</p>
                    <p><strong>الهاتف:</strong> @Model.UserPhone</p>
                    <p><strong>العنوان:</strong> @Model.Address</p>
                    <p><strong>تاريخ الطلب:</strong> @Model.CreatedAt.ToCairoTime().ToString("yyyy/MM/dd HH:mm")</p>
                    
                    <hr />
                    <form asp-action="UpdateStatus" method="post" class="row g-2 align-items-center">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(Model.RowVersion)" />
                        <div class="col-auto">
                            <label class="fw-bold">تحديث الحالة:</label>
                        </div>
                        <div class="col-auto">
                            <select name="status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<EcommerceApp.Models.PharmacyRequestStatus>()" asp-for="Status">
                            </select>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary btn-sm">حفظ</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Prescription Image -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">صورة الروشتة</h6>
                </div>
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.PrescriptionImagePath))
                    {
                        @if (!Model.PrescriptionImagePath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                        {
                            <img src="@Url.Action("DownloadPrescription", "PharmacyRequests", new { area = "", id = Model.Id })"
                                 class="img-fluid rounded" style="max-height: 300px;" alt="صورة الروشتة" />
                        }
                        <div class="mt-3">
                            <a href="@Url.Action("DownloadPrescription", "PharmacyRequests", new { area = "", id = Model.Id })"
                               target="_blank" rel="noopener" class="btn btn-primary btn-sm">
                                <i class="bi bi-arrows-fullscreen"></i> عرض بحجم كامل
                            </a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted py-5">لا توجد صورة مرفقة.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Medicines List -->
        <div class="col-12 mb-4">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">قائمة الأدوية المطلوبة</h6>
                </div>
                <div class="card-body">
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>اسم الدواء</th>
                                        <th>الكمية / الملاحظات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int i = 1; }
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>@(i++)</td>
                                            <td>@item.MedicineName</td>
                                            <td>@item.Quantity</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">لا توجد أدوية مكتوبة في القائمة.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Notes -->
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="col-12 mb-4">
                <div class="card shadow">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-warning">ملاحظات إضافية</h6>
                    </div>
                    <div class="card-body">
                        <p class="mb-0">@Model.Notes</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
