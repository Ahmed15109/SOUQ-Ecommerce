@model IEnumerable<EcommerceApp.Models.Address>

@{
    ViewData["Title"] = "عناويني";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>عناويني</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> إضافة عنوان جديد
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm p-5">
            <i class="bi bi-geo-alt fs-1 d-block mb-3 text-secondary"></i>
            <h4 class="alert-heading">لا توجد عناوين محفوظة</h4>
            <p class="mb-4">قم بإضافة عنوان جديد لتسهيل عملية الشراء في المرات القادمة.</p>
            <a asp-action="Create" class="btn btn-outline-primary">
                <i class="bi bi-plus-lg"></i> إضافة عنوان جديد
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card h-100 @(item.IsDefault ? "border-primary" : "")">
                        <div class="card-body">
                            @if (item.IsDefault)
                            {
                                <span class="badge bg-primary mb-2">العنوان الافتراضي</span>
                            }
                            <h5 class="card-title">@item.City, @item.Area</h5>
                            <p class="card-text">
                                @item.Street<br />
                                @item.Building
                                @if (!string.IsNullOrEmpty(item.Notes))
                                {
                                    <br />
                                    <small class="text-muted">@item.Notes</small>
                                }
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between">
                            @if (!item.IsDefault)
                            {
                                <form asp-action="SetDefault" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">تعيين كافتراضي</button>
                                </form>
                            }
                            else 
                            { 
                                <span></span> 
                            }
                            
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" data-confirm="هل أنت متأكد من حذف هذا العنوان؟">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> حذف
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
