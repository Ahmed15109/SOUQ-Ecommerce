@model EcommerceApp.ViewModels.TwoFactorViewModel
@{
    ViewData["Title"] = "التحقق بخطوتين";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 mb-3">التحقق بخطوتين</h2>
                    <p class="text-muted">أرسلنا رمزًا إلى بريدك الإلكتروني.</p>
                    <form asp-action="TwoFactor" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                        <input type="hidden" asp-for="RememberMe" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="mb-3">
                            <label asp-for="Code" class="form-label">رمز التحقق</label>
                            <input asp-for="Code" class="form-control" autocomplete="one-time-code" />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">تحقق</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
