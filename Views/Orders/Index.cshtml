@using EcommerceApp.Helpers
@model IEnumerable<EcommerceApp.Models.Order>

@{
    ViewData["Title"] = "طلباتي";
}

<div class="container py-4">
    <h2 class="mb-4">سجل طلباتي</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            لم تقم بأي طلبات بعد. <a href="/">تصفح المنتجات</a>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>رقم الطلب</th>
                            <th>التاريخ</th>
                            <th>العنوان</th>
                            <th>الحالة</th>
                            <th>الإجمالي</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.Id</td>
                                <td>@item.CreatedAt.ToString("yyyy/MM/dd")</td>
                                <td>@item.City, @item.Area</td>
                                <td>
                                    @{
                                        var badgeClass = item.Status switch
                                        {
                                            EcommerceApp.Models.OrderStatus.Pending => "bg-warning text-dark",
                                            EcommerceApp.Models.OrderStatus.Processing => "bg-info text-dark",
                                            EcommerceApp.Models.OrderStatus.Shipped => "bg-primary",
                                            EcommerceApp.Models.OrderStatus.Delivered => "bg-success",
                                            EcommerceApp.Models.OrderStatus.Canceled => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass">@item.Status.GetDisplayName()</span>
                                </td>
                                <td class="fw-bold">$@item.Total</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        التفاصيل
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
