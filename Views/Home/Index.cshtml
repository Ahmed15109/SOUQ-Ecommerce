
@model EcommerceApp.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "الرئيسية";
}

<section class="hero-section rounded-3 overflow-hidden mb-5 position-relative">
    <div class="hero-decoration hero-decoration-dots" aria-hidden="true"></div>
    <div class="hero-decoration hero-decoration-ring" aria-hidden="true"></div>
    <div class="hero-floating-shape hero-floating-basket" aria-hidden="true">
        <i class="bi bi-basket2-fill"></i>
    </div>

    <div class="hero-inner">
        <div class="hero-content">
            <span class="hero-kicker">عرض أسبوعي</span>
            <h1>بقوليات طازجة <br> تصل لباب منزلك</h1>
            <p>منتجات مختارة بعناية وتوصيل حتى باب المنزل.</p>
            <a asp-controller="Products" asp-action="Index" class="hero-cta">
                <span>تسوق الآن</span>
                <span class="hero-cta-icon" aria-hidden="true">
                    <i class="bi bi-arrow-left"></i>
                </span>
            </a>
        </div>
    </div>
</section>

<div class="row mb-5 g-4 text-center">
    <div class="col-6 col-md-3">
        <div class="p-4 border d-flex flex-column align-items-center rounded-3 bg-white h-100 shadow-sm hover-lift">
            <div class="icon-box bg-primary-subtle text-primary rounded-circle mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                <i class="bi bi-truck fs-3"></i>
            </div>
            <h6 class="fw-bold">توصيل سريع</h6>
            <p class="text-muted small mb-0">خلال 15 الي 30 دقيقة </p>
        </div>
    </div>
     <div class="col-6 col-md-3">
        <div class="p-4 border d-flex flex-column align-items-center rounded-3 bg-white h-100 shadow-sm hover-lift">
             <div class="icon-box bg-success-subtle text-success rounded-circle mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                <i class="bi bi-shield-check fs-3"></i>
            </div>
            <h6 class="fw-bold">دفع آمن</h6>
            <p class="text-muted small mb-0">آمن 100%</p>
        </div>
    </div>
     <div class="col-6 col-md-3">
        <div class="p-4 border d-flex flex-column align-items-center rounded-3 bg-white h-100 shadow-sm hover-lift">
             <div class="icon-box bg-warning-subtle text-warning rounded-circle mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                <i class="bi bi-arrow-counterclockwise fs-3"></i>
            </div>
            <h6 class="fw-bold">استرجاع سهل</h6>
            <p class="text-muted small mb-0">استرجاع خلال 24 ساعة </p>
        </div>
    </div>
     <div class="col-6 col-md-3">
        <div class="p-4 border d-flex flex-column align-items-center rounded-3 bg-white h-100 shadow-sm hover-lift">
             <div class="icon-box bg-info-subtle text-info rounded-circle mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                <i class="bi bi-headset fs-3"></i>
            </div>
            <h6 class="fw-bold">دعم فني</h6>
            <p class="text-muted small mb-0">دعم مخصص 24/7</p>
        </div>
    </div>
</div>

<div class="mb-5">
    <div class="text-center mb-4">
        <h3 class="fw-bold mb-1">تسوق حسب القسم</h3>
        <p class="text-muted mb-0">اختر القسم المناسب لك وابدأ التسوق بسهولة</p>
    </div>

    <div class="row g-3 justify-content-center">
        @foreach (var category in Model.Categories)
        {
            var iconStyle = string.IsNullOrWhiteSpace(category.IconColor)
                ? null
                : $"color: {category.IconColor} !important;";
            var backgroundStyle = string.IsNullOrWhiteSpace(category.IconBackgroundColor)
                ? null
                : $"background-color: {category.IconBackgroundColor} !important;";

            <div class="col-6 col-md-3">
                @if (category.LinksToPharmacyRequests)
                {
                <a asp-controller="PharmacyRequests" asp-action="Create" class="text-decoration-none">
                    <div class="category-card-simple text-center p-4 rounded-3 bg-white h-100">
                        <div class="category-icon-bg @category.ThemeClass mb-3 d-inline-flex justify-content-center align-items-center mx-auto"
                             style="@backgroundStyle">
                            <i class="@category.IconClass fs-1" style="@iconStyle"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-0">@category.Name</h6>
                        <span class="category-arrow text-primary small mt-2 d-block">
                            اطلب من الصيدلية <i class="bi bi-arrow-left"></i>
                        </span>
                    </div>
                </a>
                }
                else
                {
                <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.Id"
                   class="text-decoration-none">
                    <div class="category-card-simple text-center p-4 rounded-3 bg-white h-100">
                        <div class="category-icon-bg @category.ThemeClass mb-3 d-inline-flex justify-content-center align-items-center mx-auto"
                             style="@backgroundStyle">
                            <i class="@category.IconClass fs-1" style="@iconStyle"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-0">@category.Name</h6>
                        <span class="category-arrow text-primary small mt-2 d-block">
                            تسوق الآن <i class="bi bi-arrow-left"></i>
                        </span>
                    </div>
                </a>
                }
            </div>
        }
    </div>
</div>

<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3 class="fw-bold m-0">منتجات مميزة</h3>
        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">عرض الكل</a>
    </div>
    
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
        @foreach (var product in Model.FeaturedProducts)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm product-card">
                    <div class="position-relative">
                        @if(product.SellingMode == EcommerceApp.Models.SellingMode.ByWeight)
                        {
                            <a asp-controller="Products" asp-action="ConfigureWeight" asp-route-id="@product.Id">
                                <img src="@product.ImageUrl" class="card-img-top p-3 rounded-4" alt="@product.Name" style="object-fit: cover; height: 200px;">
                            </a>
                        }
                        else
                        {
                            <img src="@product.ImageUrl" class="card-img-top p-3 rounded-4" alt="@product.Name" style="object-fit: cover; height: 200px;">
                        }
                        <button class="btn btn-light rounded-circle shadow-sm position-absolute top-0 end-0 m-3 p-2 favorite-btn @(product.IsFavorite ? "text-danger" : "text-muted")" data-id="@product.Id">
                            <i class="bi @(product.IsFavorite ? "bi-heart-fill" : "bi-heart")"></i>
                        </button>
                    </div>
                    <div class="card-body pt-0">
                        <p class="text-muted small mb-1">
                            @(Model.CategoryNames.GetValueOrDefault(product.CategoryId) ?? "قسم")
                        </p>
                        <h6 class="card-title fw-bold text-truncate">@product.Name</h6>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="fs-5 fw-bold text-primary">
                                @((product.SellingMode == EcommerceApp.Models.SellingMode.ByWeight
                                    ? product.PricePerKg
                                    : product.Price).ToString("N2")) ج.م
                            </span>
                            @if(product.SellingMode == EcommerceApp.Models.SellingMode.ByWeight)
                            {
                                <a asp-controller="Products" asp-action="ConfigureWeight" asp-route-id="@product.Id" class="btn btn-warning btn-sm rounded-pill px-3 text-white">
                                    <i class="bi bi-gear-fill"></i>
                                    <span class="me-1">وزن</span>
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-primary btn-sm rounded-pill add-to-cart-btn px-3" data-id="@product.Id">
                                    <i class="bi bi-cart-plus"></i>
                                    <span class="add-to-cart-text me-1">أضف للسلة</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
