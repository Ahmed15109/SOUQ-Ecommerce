
@model List<EcommerceApp.Models.Product>
@{
    var categoryName = ViewData["CategoryName"] as string;
    ViewData["Title"] = categoryName;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none">الرئيسية</a></li>
        <li class="breadcrumb-item active" aria-current="page">@categoryName</li>
    </ol>
</nav>

<div class="mb-4">
    <h2 class="fw-bold">@categoryName</h2>
    <p class="text-muted">عرض @Model.Count منتجات</p>
</div>

@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-basket display-1 text-muted"></i>
        <h3 class="mt-3">لا توجد منتجات في هذا القسم.</h3>
        <a href="/" class="btn btn-primary mt-3">تصفح الأقسام</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4 footer-margin">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm product-card">
                    <div class="position-relative">
                        <img src="@product.ImageUrl" class="card-img-top p-3 rounded-4" alt="@product.Name" style="object-fit: cover; height: 200px;">
                        <button class="btn btn-light rounded-circle shadow-sm position-absolute top-0 end-0 m-3 p-2 favorite-btn @(product.IsFavorite ? "text-danger" : "text-muted")" data-id="@product.Id">
                            <i class="bi @(product.IsFavorite ? "bi-heart-fill" : "bi-heart")"></i>
                        </button>
                    </div>
                    <div class="card-body pt-0">
                         <p class="text-muted small mb-1">
                            @categoryName
                        </p>
                        <h6 class="card-title fw-bold text-truncate">@product.Name</h6>
                         <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="fs-5 fw-bold text-primary">$@product.Price</span>
                            <button class="btn btn-primary rounded-circle btn-sm p-2">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .footer-margin {
        margin-bottom: 5rem;
    }
</style>
