@model EcommerceApp.ViewModels.OrderSuccessViewModel
@{
    ViewData["Title"] = "تم الطلب بنجاح";
}

<div class="container py-5" dir="rtl" style="text-align: right;">
    <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle shadow mb-4" style="width: 100px; height: 100px;">
        <i class="bi bi-check-lg display-3"></i>
    </div>
    
    <h1 class="display-4 fw-bold mb-3">شكراً لك!</h1>
    <p class="lead text-muted mb-4">تم تقديم طلبك رقم #@Model.OrderId بنجاح.</p>
    
    <div class="card border-0 shadow-sm mx-auto mb-4" style="max-width: 900px;">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">تفاصيل الطلب</h5>
        </div>
        <div class="card-body p-4">
            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">رقم الطلب:</span>
                        <span class="fw-bold">#@Model.OrderId</span>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">تاريخ الطلب:</span>
                        <span class="fw-bold">@Model.OrderDate.ToString("dd/MM/yyyy hh:mm tt")</span>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">اسم العميل:</span>
                        <span class="fw-bold">@Model.CustomerName</span>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">رقم الهاتف:</span>
                        <span class="fw-bold">@Model.CustomerPhone</span>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <h6 class="fw-bold mb-2">عنوان التوصيل:</h6>
                <div class="bg-light p-3 rounded">
                    <p class="mb-1"><strong>المدينة/المحافظة:</strong> @Model.City</p>
                    <p class="mb-1"><strong>المنطقة:</strong> @Model.Area</p>
                    <p class="mb-1"><strong>الشارع:</strong> @Model.Street</p>
                    <p class="mb-1"><strong>المبنى:</strong> @Model.Building</p>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <p class="mb-0"><strong>ملاحظات:</strong> @Model.Notes</p>
                    }
                </div>
            </div>

            <h6 class="fw-bold mb-3">المنتجات المطلوبة:</h6>
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>صورة المنتج</th>
                            <th>اسم المنتج</th>
                            <th>السعر</th>
                            <th>الكمية</th>
                            <th>الإجمالي</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <img src="@item.ImageUrl" alt="@item.ProductName" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;">
                                </td>
                                <td class="align-middle">@item.ProductName</td>
                                <td class="align-middle">@item.UnitPrice.ToString("N2") ج.م</td>
                                <td class="align-middle">@item.Quantity</td>
                                <td class="align-middle fw-bold">@item.LineTotal.ToString("N2") ج.م</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row justify-content-end">
                <div class="col-md-5">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">المجموع الفرعي:</span>
                        <span class="fw-bold">@Model.Subtotal.ToString("N2") ج.م</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">رسوم التوصيل:</span>
                        <span class="fw-bold">@Model.DeliveryFee.ToString("N2") ج.م</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between">
                        <span class="h5 fw-bold">الإجمالي الكلي:</span>
                        <span class="h5 fw-bold text-primary">@Model.Total.ToString("N2") ج.م</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center">
        <a href="@Url.Action("InvoicePdf", "Checkout", new { id = Model.OrderId })" class="btn btn-success rounded-pill px-5 py-3 fw-bold shadow-sm me-3">
            <i class="bi bi-file-earmark-pdf me-2"></i> تحميل الفاتورة PDF
        </a>
        <a href="/" class="btn btn-primary rounded-pill px-5 py-3 fw-bold shadow-sm">
            <i class="bi bi-arrow-right me-2"></i> متابعة التسوق
        </a>
    </div>
</div>
