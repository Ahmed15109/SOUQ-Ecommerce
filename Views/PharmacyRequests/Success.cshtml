@{
    ViewData["Title"] = "تم إرسال الطلب";
}

<div class="container py-5 text-center">
    <div class="card shadow-sm border-0 d-inline-block p-5" style="max-width: 600px;">
        <div class="mb-4 text-success">
            <i class="bi bi-check-circle-fill display-1"></i>
        </div>
        <h2 class="fw-bold mb-3">تم استلام طلبك بنجاح!</h2>
        <p class="text-muted mb-4 lead">شكراً لك. سنقوم بمراجعة طلبك وتجهيز الأدوية المطلوبة في أقرب وقت.</p>
        
        @if (ViewData["RequestId"] is int requestId)
        {
            <p class="alert alert-light border">رقم الطلب المرجعي: <strong>#@requestId</strong></p>
        }

        <div class="d-flex justify-content-center gap-2">
            <a href="/" class="btn btn-outline-secondary rounded-pill px-4">العودة للرئيسية</a>
            <a href="/PharmacyRequests/Create" class="btn btn-primary rounded-pill px-4">طلب دواء آخر</a>
        </div>
    </div>
</div>
