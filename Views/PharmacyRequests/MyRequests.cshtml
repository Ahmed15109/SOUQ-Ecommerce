@using EcommerceApp.Helpers
@model EcommerceApp.ViewModels.PagedResult<EcommerceApp.Models.PharmacyRequest>

@{
    ViewData["Title"] = "طلباتي الصيدلانية";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary"><i class="bi bi-list-check me-2"></i>طلباتي الصيدلانية</h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill">
            <i class="bi bi-plus-lg me-1"></i> طلب جديد
        </a>
    </div>

    @if (Model.TotalCount == 0)
    {
        <div class="alert alert-info text-center shadow-sm p-5">
            <i class="bi bi-capsule fs-1 d-block mb-3 text-secondary"></i>
            <h4 class="alert-heading">لا توجد طلبات</h4>
            <p class="mb-0">لم تقم بإرسال أي طلبات صيدلانية حتى الآن.</p>
            <a asp-action="Create" class="btn btn-outline-primary mt-3">ابدا طلبك الآن</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model.Items)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                            <span class="fw-bold text-dark">طلب #@item.Id</span>
                            @{
                                var status = item.Status;
                                string badgeClass = status switch
                                {
                                    EcommerceApp.Models.PharmacyRequestStatus.New => "primary",
                                    EcommerceApp.Models.PharmacyRequestStatus.Processing => "info",
                                    EcommerceApp.Models.PharmacyRequestStatus.Shipped => "warning",
                                    EcommerceApp.Models.PharmacyRequestStatus.Delivered => "success",
                                    EcommerceApp.Models.PharmacyRequestStatus.Cancelled => "danger",
                                    _ => "secondary"
                                };
                            }
                            <span class="badge bg-@badgeClass">@item.Status.GetDisplayName()</span>
                        </div>
                        <div class="card-body">
                            <p class="card-text text-muted small mb-2"><i class="bi bi-calendar3 me-1"></i> @item.CreatedAt.ToCairoTime().ToString("yyyy/MM/dd HH:mm")</p>
                            
                            @if (item.Items.Any())
                            {
                                <h6 class="fw-bold mt-3 mb-2">الأدوية المطلوبة:</h6>
                                <ul class="list-group list-group-flush small mb-3">
                                    @foreach (var med in item.Items.Take(3))
                                    {
                                        <li class="list-group-item px-0 py-1 border-0">
                                            <i class="bi bi-dot me-1 text-primary"></i> @med.MedicineName (@med.Quantity)
                                        </li>
                                    }
                                    @if (item.Items.Count > 3)
                                    {
                                        <li class="list-group-item px-0 py-1 border-0 text-muted fst-italic">... والمزيد</li>
                                    }
                                </ul>
                            }
                            
                            @if (!string.IsNullOrEmpty(item.PrescriptionImagePath))
                            {
                                <a asp-action="DownloadPrescription" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener">
                                    <i class="bi bi-paperclip me-1"></i> عرض المرفق
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <partial name="_Pagination" model="Model" />
    }
</div>
