@model ErrorViewModel
@{
    ViewData["Title"] = "حدث خطأ";
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle display-1 text-danger" aria-hidden="true"></i>
    <h1 class="h2 mt-3">تعذر إكمال الطلب</h1>
    <p class="text-muted">حدث خطأ غير متوقع. حاول مرة أخرى لاحقًا.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">
            رقم التتبع: <code>@Model.RequestId</code>
        </p>
    }
    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">العودة للرئيسية</a>
</div>
