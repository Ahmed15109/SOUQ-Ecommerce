@using Microsoft.AspNetCore.Http
@using EcommerceApp.Services
@inject INotificationService NotificationService
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - متجر إلكتروني</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EcommerceApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="d-flex flex-column min-vh-100">
    @{
        var favoritesCount = 0;
        var favoritesJson = Context?.Session?.GetString("Favorites");
        if (!string.IsNullOrEmpty(favoritesJson))
        {
            favoritesCount = (System.Text.Json.JsonSerializer.Deserialize<List<int>>(favoritesJson) ?? new List<int>()).Count;
        }

        var cartCount = 0;
        var cartJson = Context?.Session?.GetString("Cart");
        if (!string.IsNullOrEmpty(cartJson))
        {
            var cart = System.Text.Json.JsonSerializer.Deserialize<List<EcommerceApp.Models.CartItem>>(cartJson) ?? new List<EcommerceApp.Models.CartItem>();
            cartCount = cart.Sum(x => x.Quantity);
        }

        var notificationCount = 0;
        if (User.Identity?.IsAuthenticated == true)
        {
            var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            var isAdmin = User.IsInRole("Admin");
            notificationCount = await NotificationService.GetUnreadCountAsync(userId, isAdmin);
        }
    }

    <div class="top-bar py-2 text-white">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center font-sm gap-2">
            <div>
                <i class="bi bi-telephone-fill me-1"></i> 01024842730
                <span class="mx-2">|</span>
                <i class="bi bi-envelope-fill me-1"></i> ahmedalshafei151@gmail.com
            </div>
            <div>
                <span class="me-3"><i class="bi bi-globe me-1"></i> العربية</span>
                <span><i class="bi bi-cash-coin me-1"></i> ج.م</span>
            </div>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top py-3">
        <div class="container">
            <a class="navbar-brand fw-bold fs-3 text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-bag-heart-fill me-2"></i>تسوق الآن
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse">
                <form class="d-flex mx-auto my-2 my-lg-0 w-50 position-relative">
                    <input class="form-control rounded-pill ps-4 pe-5 bg-light border-0" type="search"
                           placeholder="ابحث عن المنتجات..." aria-label="Search">
                    <button class="btn position-absolute top-50 end-0 translate-middle-y me-2 text-muted" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </form>

                <ul class="navbar-nav mb-2 mb-lg-0 align-items-center ms-auto">
                    <li class="nav-item d-flex align-items-center me-3 gap-2">
                         @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i>
                                    @{
                                        var fullName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;
                                        if (string.IsNullOrEmpty(fullName))
                                        {
                                            fullName = User.Identity?.Name?.Split('@')[0] ?? "User";
                                        }
                                    }
                                    أهلاً، @fullName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index">طلباتي</a></li>
                                    <li><a class="dropdown-item" asp-controller="Addresses" asp-action="Index">عناويني</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                            <button type="submit" class="btn btn-sm btn-danger w-100">خروج</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-primary rounded-pill px-3">دخول</a>
                        }
                    </li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item me-3">
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="nav-link position-relative fs-5 text-dark" asp-area="Admin" asp-controller="Notifications" asp-action="Index">
                                    <i class="bi bi-bell"></i>
                                    @if (notificationCount > 0)
                                    {
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark" style="font-size: 0.6rem;">
                                            @notificationCount
                                        </span>
                                    }
                                </a>
                            }
                            else
                            {
                                <a class="nav-link position-relative fs-5 text-dark" asp-controller="Notifications" asp-action="Index">
                                    <i class="bi bi-bell"></i>
                                    @if (notificationCount > 0)
                                    {
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark" style="font-size: 0.6rem;">
                                            @notificationCount
                                        </span>
                                    }
                                </a>
                            }
                        </li>
                    }

                    <li class="nav-item me-3">
                        <a class="nav-link position-relative fs-5 text-dark" href="/Favorites">
                            <i class="bi bi-heart"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">
                                @favoritesCount
                            </span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link position-relative fs-5 text-dark" href="/Cart">
                            <i class="bi bi-cart3"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary" style="font-size: 0.6rem;">
                                @cartCount
                            </span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main role="main" class="flex-fill">
        <div class="container py-3">
            @RenderBody()
        </div>
    </main>

    <footer class="border-top footer text-muted pt-5 pb-4 mt-auto">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-bag-heart-fill me-2 text-primary"></i>تسوق الآن
                    </h5>
                    <p class="small mb-3">منصة تجارة إلكترونية حديثة لجميع احتياجاتك اليومية. توصيل سريع ودفع آمن.</p>
                    <div class="d-flex gap-2">
                        <a href="#" class="social-icon-btn text-decoration-none"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-icon-btn text-decoration-none"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-icon-btn text-decoration-none"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="social-icon-btn text-decoration-none"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>

                <div class="col-md-2 mb-3">
                    <h6 class="text-dark fw-bold mb-3">التسوق</h6>
                    <ul class="list-unstyled small">
                        <li class="footer-link-item"><a href="#" class="text-decoration-none text-muted">خضروات</a></li>
                        <li class="footer-link-item"><a href="#" class="text-decoration-none text-muted">بقالة</a></li>
                        <li class="footer-link-item"><a href="#" class="text-decoration-none text-muted">صيدلية</a></li>
                    </ul>
                </div>

                <div class="col-md-2 mb-3">
                    <h6 class="text-dark fw-bold mb-3">الشركة</h6>
                    <ul class="list-unstyled small">
                        <li class="footer-link-item"><a href="#" class="text-decoration-none text-muted">من نحن</a></li>
                        <li class="footer-link-item"><a href="tel:+201024842730" class="text-decoration-none text-muted">اتصل بنا</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="footer-link-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index" class="text-decoration-none text-primary fw-bold">لوحة التحكم</a></li>
                            <li class="footer-link-item"><a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="text-decoration-none text-muted">إدارة الطلبات</a></li>
                            <li class="footer-link-item"><a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="text-decoration-none text-muted">الأقسام</a></li>
                            <li class="footer-link-item"><a asp-area="Admin" asp-controller="Products" asp-action="Index" class="text-decoration-none text-muted">المنتجات</a></li>
                        }
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <li class="footer-link-item"><a asp-area="Admin" asp-controller="AdminUsers" asp-action="Index" class="text-decoration-none text-danger fw-bold">إدارة المسؤولين</a></li>
                        }
                    </ul>
                </div>

<div class="col-md-4 mb-3 footer-whatsapp-cta">
                    <h6 class="text-dark fw-bold mb-2">كوميونتي واتساب</h6>
                    <p class="small text-muted mb-3">عروض وتنبيهات فورية – تواصل مباشر</p>
                    <a href="https://whatsapp.com/channel/0029Vb6uhK93rZZcjX6zJX12" target="_blank" class="btn btn-whatsapp w-100 d-flex align-items-center justify-content-center gap-2 py-2">
                        <i class="bi bi-whatsapp fs-5"></i>
                        <span class="fw-bold">انضم للواتساب</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="footer-bottom py-2 mt-2 w-100">
            <div class="container text-center text-muted">
                &copy; 2026 - متجر إلكتروني - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted">سياسة الخصوصية</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
